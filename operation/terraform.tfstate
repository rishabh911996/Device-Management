              "\"adminPassword\": \"admin\"\n\"dashboards\":\n  \"default\":\n    \"kubernetes-cluster\":\n      \"datasource\": \"Prometheus\"\n      \"gnetId\": 7249\n      \"revision\": 1\n    \"kubernetes-logs\":\n      \"datasource\": \"Loki\"\n      \"gnetId\": 15141\n      \"revision\": 1\n    \"loki-logs\":\n      \"datasource\": \"Loki\"\n      \"gnetId\": 13639\n      \"revision\": 2\n    \"prometheus-stats\":\n      \"datasource\": \"Prometheus\"\n      \"gnetId\": 2\n      \"revision\": 2\n\"datasources\":\n  \"datasources.yaml\":\n    \"apiVersion\": 1\n    \"datasources\":\n    - \"access\": \"proxy\"\n      \"isDefault\": true\n      \"name\": \"Prometheus\"\n      \"type\": \"prometheus\"\n      \"url\": \"http://prometheus-server.monitoring.svc.cluster.local\"\n    - \"access\": \"proxy\"\n      \"jsonData\":\n        \"maxLines\": 1000\n      \"name\": \"Loki\"\n      \"type\": \"loki\"\n      \"url\": \"http://loki.monitoring.svc.cluster.local:3100\"\n    - \"access\": \"proxy\"\n      \"name\": \"Tempo\"\n      \"type\": \"tempo\"\n      \"url\": \"http://tempo.monitoring.svc.cluster.local:3100\"\n\"persistence\":\n  \"enabled\": false\n\"resources\":\n  \"limits\":\n    \"cpu\": \"200m\"\n    \"memory\": \"256Mi\"\n  \"requests\":\n    \"cpu\": \"100m\"\n    \"memory\": \"128Mi\"\n\"service\":\n  \"nodePort\": 30080\n  \"type\": \"NodePort\"\n"
