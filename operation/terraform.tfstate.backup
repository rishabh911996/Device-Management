    {
      "mode": "managed",
      "type": "helm_release",
      "name": "loki",
      "provider": "provider[\"registry.terraform.io/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "loki-stack",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": false,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "loki",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "v2.6.1",
                "chart": "loki-stack",
                "first_deployed": 1749606490,
                "last_deployed": 1749607775,
                "name": "loki",
                "namespace": "monitoring",
                "notes": "Verify the application is working by running these commands:\n  kubectl --namespace monitoring port-forward service/loki 3100\n  curl http://127.0.0.1:3100/api/prom/label\n\nThe Loki stack has been deployed to your cluster. Loki can now be added as a datasource in Grafana.\n\nSee http://docs.grafana.org/features/datasources/loki/ for more detail.\n\n***********************************************************************\n Welcome to Grafana Promtail\n Chart version: 6.13.1\n Promtail version: 2.8.3\n***********************************************************************\n\nVerify the application is working by running these commands:\n* kubectl --namespace monitoring port-forward daemonset/loki-promtail 3101\n* curl http://127.0.0.1:3101/metrics\n",
                "revision": 2,
                "values": "{\"loki\":{\"auth_enabled\":false,\"config\":{\"frontend\":{\"compress_responses\":true,\"log_queries_longer_than\":\"10s\"},\"limits_config\":{\"max_cache_freshness_per_query\":\"10m\",\"max_entries_limit_per_query\":5000,\"max_query_parallelism\":32,\"split_queries_by_interval\":\"15m\"},\"querier\":{\"engine\":{\"max_look_back_period\":\"5m\",\"timeout\":\"3m\"}},\"query_scheduler\":{\"max_outstanding_requests_per_tenant\":2048},\"runtime_config\":{\"features\":{\"analytics\":true,\"parser\":true,\"sensitivity\":true,\"volume\":true}}},\"enabled\":true},\"serviceMonitor\":{\"enabled\":true,\"interval\":\"30s\"}}",
                "version": "2.9.11"
              }
            ],
            "name": "loki",
            "namespace": "monitoring",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": "https://grafana.github.io/helm-charts",
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [
              {
                "name": "loki.enabled",
                "type": "",
                "value": "true"
              }
            ],
            "set_list": [],
            "set_sensitive": [],
            "skip_crds": false,
            "status": "pending-upgrade",
            "timeout": 300,
            "upgrade_install": null,
            "values": [
              "\"loki\":\n  \"auth_enabled\": false\n  \"config\":\n    \"ingester\":\n      \"chunk_idle_period\": \"5m\"\n      \"chunk_retain_period\": \"30s\"\n      \"lifecycler\":\n        \"ring\":\n          \"kvstore\":\n            \"store\": \"inmemory\"\n          \"replication_factor\": 1\n    \"limits_config\":\n      \"enforce_metric_name\": false\n      \"max_cache_freshness_per_query\": \"10m\"\n      \"reject_old_samples\": true\n      \"reject_old_samples_max_age\": \"168h\"\n    \"memberlist\":\n      \"join_members\":\n      - \"loki-headless.monitoring.svc.cluster.local\"\n    \"schema_config\":\n      \"configs\":\n      - \"from\": \"2020-10-24\"\n        \"index\":\n          \"period\": \"24h\"\n          \"prefix\": \"index_\"\n        \"object_store\": \"filesystem\"\n        \"schema\": \"v11\"\n        \"store\": \"boltdb-shipper\"\n    \"storage_config\":\n      \"boltdb_shipper\":\n        \"active_index_directory\": \"/data/loki/index\"\n        \"cache_location\": \"/data/loki/cache\"\n        \"cache_ttl\": \"24h\"\n        \"shared_store\": \"filesystem\"\n      \"filesystem\":\n        \"directory\": \"/data/loki/chunks\"\n  \"persistence\":\n    \"enabled\": false\n"
            ],
            "verify": false,
            "version": "2.9.11",
            "wait": true,
            "wait_for_jobs": false
          },
